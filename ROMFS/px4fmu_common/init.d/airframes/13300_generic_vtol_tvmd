param set-default CA_MD3_AZ 0
param set-default CA_MD3_X_GR 1.0
param set-default CA_MD3_Y_GR 1.0

# Rotor settings - Single propeller H-frame (4 motors, max 6N each)

param set-default CA_ROTOR_COUNT 4     # Changed: 8 -> 4 (single prop per module)

# Motor 0 (Module 0, Front-Left, CW)
param set-default CA_ROTOR0_CT 0.012   # Changed: 0.020231 -> 0.012 (adjust after hover test)
param set-default CA_ROTOR0_KM -0.0188 # CW rotation (correct)
param set-default CA_ROTOR0_PX 0
param set-default CA_ROTOR0_PY 0
param set-default CA_ROTOR0_PZ 0.0     # Changed: 0.2 -> 0.0 (single prop at module center)
param set-default CA_ROTOR0_TILT 1


# Motor 1 (Module 1, Front-Right, CCW)
param set-default CA_ROTOR1_CT 0.012   # Changed: 0.020231 -> 0.012
param set-default CA_ROTOR1_KM 0.0188  # CCW rotation (correct)
param set-default CA_ROTOR1_PX 0
param set-default CA_ROTOR1_PY 0
param set-default CA_ROTOR1_PZ 0.0     # Changed: -0.2 -> 0.0
param set-default CA_ROTOR1_TILT 2



# Motor 2 (Module 2, Rear-Left, CCW)
param set-default CA_ROTOR2_CT 0.012   # Changed: 0.020231 -> 0.012
param set-default CA_ROTOR2_KM 0.0188  # Changed: -0.0188 -> 0.0188 (CCW rotation)
param set-default CA_ROTOR2_PX 0
param set-default CA_ROTOR2_PY 0
param set-default CA_ROTOR2_PZ 0.0     # Changed: 0.2 -> 0.0
param set-default CA_ROTOR2_TILT 3


# Motor 3 (Module 3, Rear-Right, CW)
param set-default CA_ROTOR3_CT 0.012   # Changed: 0.020231 -> 0.012
param set-default CA_ROTOR3_KM -0.0188 # Changed: 0.0188 -> -0.0188 (CW rotation)
param set-default CA_ROTOR3_PX 0
param set-default CA_ROTOR3_PY 0
param set-default CA_ROTOR3_PZ 0.0     # Changed: -0.2 -> 0.0
param set-default CA_ROTOR3_TILT 4

