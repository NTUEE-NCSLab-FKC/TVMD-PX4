#!/bin/sh
#
# @name Generic VTOL TVMD : H-frame, 4x ducted fan + 8x tilting servos
#
# @type VTOL TVMD
# @class VTOL
#
# @maintainer Sciyen <sciyen.ycc@gmail.com>
# @maintainer FKC <d12921b11@ntu.edu.tw>
#
# @output Motor1 motor 1 (module 0, front-left, CW)
# @output Motor2 motor 2 (module 1, front-right, CCW)
# @output Motor3 motor 3 (module 2, rear-left, CCW)
# @output Motor4 motor 4 (module 3, rear-right, CW)
# @output Servo1 tilt servo 1 (module 0, X-axis)
# @output Servo2 tilt servo 2 (module 0, Y-axis)
# @output Servo3 tilt servo 3 (module 1, X-axis)
# @output Servo4 tilt servo 4 (module 1, Y-axis)
# @output Servo5 tilt servo 5 (module 2, X-axis)
# @output Servo6 tilt servo 6 (module 2, Y-axis)
# @output Servo7 tilt servo 7 (module 3, X-axis)
# @output Servo8 tilt servo 8 (module 3, Y-axis)
#

. ${R}etc/init.d/rc.tvmd_defaults

param set-default MAV_TYPE 21

param set-default EKF2_FUSE_BETA 0 # side slip fusion is currently not supported for tailsitters

param set-default CA_AIRFRAME 13
param set-default CA_METHOD 3


## General Settings
param set-default SENS_BOARD_ROT 20     ## FCU direction: ROTATION_ROLL_270

param set-default EKF2_EV_CTRL 11       ## Enable external vision in EKF2
param set-default EKF2_BARO_CTRL 0      ## We trust vision feedback
param set-default MAV_1_CONFIG 102      ## TELEM 2
param set-default MAV_1_MODE 8          ## EXTERNAL VISION

param set-default COM_DISARM_PRFLT 600  ## 10 minutes before force disarming (for debugging)
param set-default COM_POWER_COUNT 0     ## We only have one power source
param set-default BAT1_N_CELLS 4

param set-default CBRK_AIRSPD_CHK 162128
param set-default COM_CPU_MAX -1


# Module settings - H-frame configuration (1.4kg, L=0.185m, W=0.16m)

param set-default CA_MD_COUNT 4


param set-default CA_MD0_PX 0.185      # Front-Left (changed from 0.215)
param set-default CA_MD0_PY 0.16       # (changed from 0.215)
param set-default CA_MD0_PZ 0
param set-default CA_MD0_AZ 0          # All modules same orientation (changed from 1)
param set-default CA_MD0_X_GR 1.0
param set-default CA_MD0_Y_GR 1.0


param set-default CA_MD1_PX 0.185      # Front-Right (changed from 0.215)
param set-default CA_MD1_PY -0.16      # (changed from -0.215)
param set-default CA_MD1_PZ 0
param set-default CA_MD1_AZ 0          # All modules same orientation (changed from 1)
param set-default CA_MD1_X_GR 1.0
param set-default CA_MD1_Y_GR 1.0


param set-default CA_MD2_PX -0.185     # Rear-Left (changed from -0.215)
param set-default CA_MD2_PY 0.16       # (changed from 0.215)
param set-default CA_MD2_PZ 0
param set-default CA_MD2_AZ 0
param set-default CA_MD2_X_GR 1.0
param set-default CA_MD2_Y_GR 1.0


param set-default CA_MD3_PX -0.185     # Rear-Right (changed from -0.215)
